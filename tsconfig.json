{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "apps/api/**/*.ts",
    "apps/workers/**/*.ts",
    "packages/**/*.ts",
    "infra/local/**/*.ts",
    "tests/**/*.ts",
    "prisma.config.ts"
  ]
}
