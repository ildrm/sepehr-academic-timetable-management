# Copy to a local untracked file and replace every empty secret before starting.
# This example uses fictional data and a loopback-only development origin.
APP_ENV=development
ENABLE_DEVELOPMENT_AUTH=true
ALLOW_SYNTHETIC_SEED=true
LOCAL_DB_PASSWORD=
DATABASE_URL=
DEV_BOOTSTRAP_PASSWORD=
CURSOR_SECRET=
WEB_ORIGIN=http://localhost:3000
INTERNAL_API_URL=http://127.0.0.1:4100
API_HOST=127.0.0.1
API_PORT=4100
COOKIE_SECURE=false
REQUEST_RETENTION_HOURS=72
QUEUE_REDIS_URL=redis://127.0.0.1:56379
SOLVER_PYTHON=.venv/bin/python
SOLVER_LIMIT_SECONDS=5

# HTTPS institutional deployments only; exact issuer and preprovisioned issuer/subject pairs.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_STAFF_ACR=
