APP_IMAGE=registry.example.edu/academic/application@sha256:replace-with-approved-digest
WEB_ORIGIN=https://academic.example.edu
WEB_LOOPBACK_PORT=3000
OIDC_ISSUER=https://identity.example.edu
OIDC_CLIENT_ID=academic-portal
OIDC_STAFF_ACR=replace-with-approved-value
API_DATABASE_SECRET=/etc/academic/secrets/api-database
WORKER_DATABASE_SECRET=/etc/academic/secrets/worker-database
MIGRATION_DATABASE_SECRET=/etc/academic/secrets/migration-database
QUEUE_REDIS_SECRET=/etc/academic/secrets/queue-redis
OIDC_SECRET_FILE=/etc/academic/secrets/oidc
CURSOR_SECRET_FILE=/etc/academic/secrets/cursor
REQUEST_RETENTION_HOURS=
SOLVER_LIMIT_SECONDS=
REPORT_MIN_CELL=
