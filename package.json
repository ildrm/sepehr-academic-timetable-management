{
  "name": "teaching-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx infra/local/seed.ts",
    "api": "node --import tsx apps/api/src/main.ts",
    "worker": "node --import tsx apps/workers/src/main.ts",
    "web": "npm run dev -w @teaching/web",
    "typecheck": "tsc --noEmit && npm run typecheck -w @teaching/web",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "build": "tsc -p tsconfig.build.json && npm run build -w @teaching/web",
    "lint": "eslint apps packages infra/local tests",
    "test:e2e": "node --import tsx --test tests/e2e/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "bullmq": "5.81.6",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "openid-client": "6.9.1",
    "pg": "8.18.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@types/express": "5.0.6",
    "@types/node": "24.10.13",
    "eslint": "9.39.3",
    "playwright": "1.63.0",
    "prisma": "7.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
